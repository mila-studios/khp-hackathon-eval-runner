# Copy to .env and fill in values:
#   cp .env.example .env
#
# NOTE: .env is gitignored; do not commit real secrets.

# LLM API keys — only variables ending in _API_KEY are forwarded to team scripts
OPENAI_API_KEY=your_api_key_here
# ANTHROPIC_API_KEY=your_api_key_here

# Runner inputs
TEAM_LIST=teams.csv
INPUT_CSV=datasets/input.csv

# Runner outputs (optional overrides)
WORK_DIR=
OUT_DIR=
RUN_ID=

# Timeouts (seconds)
CLONE_TIMEOUT=600
CONFIGURE_TIMEOUT=600
PREDICT_TIMEOUT=7200
EVAL_TIMEOUT=600

# Failure handling
# 1 = keep going after failures, 0 = stop after first failure
CONTINUE_ON_FAILURE=1

# Stage scripts (optional overrides)
CONFIGURE_SCRIPT=project/scripts/configure.sh
PREDICT_SCRIPT=project/scripts/predict.sh

# Evaluator (optional override)
EVAL_SCRIPT=scripts/evaluate.sh

# Artifact filenames (optional overrides, relative to each team's output dir)
PRED_FILENAME=predictions/predictions.csv
METRICS_FILENAME=metrics/metrics.csv

# Logging (optional)
FORCE_COLOR=1
NO_COLOR=

